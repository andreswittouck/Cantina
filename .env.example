# ---------------------------------------------------------------------------
# Copiá este archivo como .env.local y completá con los datos de tu proyecto.
# Los valores salen de: Supabase → tu proyecto → Project Settings → API
# ---------------------------------------------------------------------------

# URL del proyecto. Ej: https://abcdefghijk.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública ("anon" / "publishable"). Va al navegador: no es secreta.
# Lo que protege los datos es Row Level Security, no esconder esta clave.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Clave service_role. SECRETA: saltea todas las políticas de seguridad.
#
# Se usa para UNA sola cosa: crear el login cuando un dueño o un admin da de
# alta a alguien desde Usuarios. Sin esto, el alta de usuarios no funciona.
#
# Nunca con prefijo NEXT_PUBLIC_ (eso la mandaría al navegador) y nunca en el
# repositorio. En Netlify va en Project configuration → Environment variables.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
